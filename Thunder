local bpm = 133
adjustVelocity(1)

-- ==========================================
-- DEFINICIÓN DE LAS PARTES (EL CEREBRO DEL SCRIPT)
-- ==========================================

-- 1. Tapping Inicial (El inicio que va subiendo)
local function tocarIntro()
    for i = 1, 8 do
        keypress("a", 0.1, bpm) rest(0.25, bpm)
        keypress("D", 0.1, bpm) rest(0.25, bpm)
        keypress("a", 0.1, bpm) rest(0.25, bpm)
        keypress("G", 0.1, bpm) rest(0.25, bpm)
    end
    for i = 1, 8 do
        keypress("a", 0.1, bpm) rest(0.25, bpm)
        keypress("f", 0.1, bpm) rest(0.25, bpm)
        keypress("a", 0.1, bpm) rest(0.25, bpm)
        keypress("h", 0.1, bpm) rest(0.25, bpm)
    end
end

